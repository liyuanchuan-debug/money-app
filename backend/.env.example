# Database (Supabase PostgreSQL)
# asyncpg 同时接受 postgresql:// 和 postgres:// 两种 scheme，粘贴 Supabase 连接串即可
# 密码含特殊字符时需 URL 编码；未设置时后端退化为内存存储
#
# ⚠️ Render 等只有 IPv4 出口的托管平台**必须**用 Connection Pooling（pooler）主机：
#    直连主机 db.<ref>.supabase.co 只解析到 IPv6，Render 连不上（连接超时）。
#    正确形态：<region>.pooler.supabase.com:5432（Session）或 :6543（Transaction）
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

# CORS — comma-separated frontend origins
# 支持 `*` 通配子域名，用于 Vercel Preview：https://*.vercel.app
# 单独写 `*` 表示放行所有来源（此时 allow_credentials 自动关闭）
# ⚠️ 开了登录之后 CORS_ORIGINS 不能再写 `*`：allow_credentials=false 会导致
#    浏览器不携带会话 Cookie，登录必定失败——必须写前端真实域名。
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-app.vercel.app

# ---------------------------------------------------------------------------
# 认证 / 权限（RBAC）
# ---------------------------------------------------------------------------

# 会话签名密钥（HMAC-SHA256）。**生产环境必填**：缺失时后端直接抛错拒绝启动；
# 本地开发缺失会打印醒目告警并使用不安全的兜底密钥。
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
# ⚠️ 更换该值会让所有已登录用户的会话立刻失效。
SESSION_SECRET=

# 权限校验总开关。默认 true（未设置也视为开启）：受保护接口按角色矩阵校验。
# 本地调试 API 时可显式设为 false 旁路；生产务必保持 true。
# 注意：前端菜单/路由不依赖本开关——未登录在 UI 上始终按访客处理。
AUTH_ENFORCED=true

# 会话有效期。默认 365 天：登录后只要不清站点数据 / 不点退出，一直有效。
# 优先读 JWT_EXPIRE_DAYS（天）；需要秒级精细控制时用 SESSION_TTL_SECONDS（秒优先）。
# JWT_EXPIRE_DAYS=365
# SESSION_TTL_SECONDS=31536000

# Cookie SameSite：lax（默认）| strict | none
# 登录方案 = **同源反代**（前端框架把 /api 反代到后端，浏览器只见前端域名）：
#   同站请求，保持默认 lax 即可，**不要**改成 none。
# 只有真正**跨站**部署（前端 *.vercel.app 直连后端 *.onrender.com）才需要 none；
#   lax 的 Cookie 不随跨站 fetch 发送，会表现为「登录成功但下一个请求仍未登录」。
#   none 会自动强制 Secure，因此只能在 HTTPS 下使用。
SESSION_COOKIE_SAMESITE=lax

# 显式指定 Cookie 的 Secure 标志。不设时按请求协议自动判断
# （https 或 X-Forwarded-Proto: https → Secure）。
# ⚠️ 生产（Render / nginx 等代理后）建议显式 true：uvicorn 默认不信任代理的
#    X-Forwarded-Proto，靠 request.url.scheme 自动判定可能拿不到 https 而漏加 Secure。
#    Render 侧已在 render.yaml 里钉死 true。本地走 http 调试时保持注释
#    （Safari 会丢弃 http 下的 Secure Cookie）。
# SESSION_COOKIE_SECURE=true

# 环境标识。设为 production 时，缺失 SESSION_SECRET 会直接启动失败。
# Render 上会自动注入 RENDER=true，无需手工设置。
# APP_ENV=production
